# Server environment configuration.
# Copy this file to `.env` and fill in your own values.
# Do NOT commit the real `.env` — see `.gitignore`.

# MongoDB Atlas connection string. Format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DB_URL=

# Express server port (default 2408)
PORT=2408

# JWT signing secret. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed CORS origin. Use the exact deployed front-end origin in production.
CORS_ORIGIN=http://localhost:5173

# Resend password-reset email configuration.
# The sender must be a verified domain or address in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PathSeeker <no-reply@your-verified-domain.example>

# Cloudinary managed asset storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
